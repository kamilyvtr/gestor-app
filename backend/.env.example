# Copie para .env e ajuste conforme o ambiente.
AMBIENTE=development
DEBUG=true

# Deixe comentado para usar backend/data/gestor_senai.db (caminho absoluto).
# DATABASE_URL=sqlite:///./data/gestor_senai.db
# PostgreSQL:
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/gestor_senai

# Gere uma chave forte, por exemplo: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-esta-chave-em-producao
JWT_EXPIRA_MINUTOS=480

# Em produção com HTTPS, defina true.
COOKIE_SECURE=false

# O front-end roda em outra porta; credenciais exigem origens exatas.
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:5500","http://127.0.0.1:5500"]

SEED_ON_STARTUP=true

# Web Push (VAPID)
#
# Desenvolvimento: as chaves ficam em backend/.vapid/ (geradas por
# scripts/gerar_vapid.py) e são lidas automaticamente — não precisa definir nada.
#
# Produção (Render, disco efêmero): o arquivo .vapid/private_key.pem não vai para
# o Git, então informe o conteúdo PEM em VAPID_PRIVATE_KEY. Pode colar com as
# quebras de linha reais ou em uma linha só usando \n (o backend normaliza).
VAPID_SUBJECT=mailto:dev@gestorsenai.local
# VAPID_PUBLIC_KEY=BAyDOTrN61MQhOdSMrD94Sgdj27R5eJ1N0DYsXcx-Y9LRh4ZrfZBaprLNxeu4PaYte7BxtaCzz-B2_OltrrQyRk
# VAPID_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"
# VAPID_PRIVATE_KEY_PATH=./.vapid/private_key.pem
